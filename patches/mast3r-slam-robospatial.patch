+def clone_frame_for_export(frame: Frame) -> Frame:
+    export_frame = Frame(
+        frame.frame_id,
+        frame.img.detach().cpu().clone(),
+        frame.img_shape.detach().cpu().clone(),
+        frame.img_true_shape.detach().cpu().clone(),
+        frame.uimg.detach().cpu().clone(),
+        lietorch.Sim3(frame.T_WC.data.detach().cpu().clone()),
+    )
+    export_frame.X_canon = frame.X_canon.detach().cpu().clone()
+    export_frame.C = frame.C.detach().cpu().clone()
+    export_frame.N = frame.N
+    export_frame.N_updates = frame.N_updates
+    if frame.K is not None:
+        export_frame.K = frame.K.detach().cpu().clone()
+    return export_frame
+
